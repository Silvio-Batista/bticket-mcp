# Base URL of the B-Ticket Laravel API (without trailing slash).
# Requests go to {BTICKET_API_URL}/api/...
BTICKET_API_URL=https://your-bticket-host.example.com

# Login credentials (used when BTICKET_TOKEN is empty).
BTICKET_EMAIL=you@example.com
BTICKET_PASSWORD=change-me

# Optional long-lived Sanctum token. When set, login is skipped.
BTICKET_TOKEN=

# HTTP transport port (start:http). Default: 3000
PORT=3000
